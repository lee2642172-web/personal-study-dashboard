VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Server only; never prefix the encryption key with VITE_.
# The server also accepts the existing VITE_SUPABASE_* public connection values.
DASHBOARD_CHAT_ORIGIN=https://personal-study-dashboard-tau.vercel.app
DASHBOARD_CHAT_SECRET=generate_32_random_bytes_using_the_connection_page
# Optional server-only aliases:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Configure these in the Codex environment, not the browser/Vercel client bundle:
# DASHBOARD_CHAT_URL=https://personal-study-dashboard-tau.vercel.app
# DASHBOARD_CHAT_TOKEN=copy_the_issued_connection_key_to_Codex_secrets_only
